<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="gestionPU" transaction-type="JTA">

        <!-- Datasource MySQL déclarée dans WildFly (voir LISEZMOI.md, étape 2) -->
        <jta-data-source>java:/jdbc/UniversiteDS</jta-data-source>

        <class>model.Etudiant</class>
        <class>model.Filiere</class>

        <properties>
            <!-- Hibernate crée/met à jour les tables automatiquement -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>

    </persistence-unit>

</persistence>
